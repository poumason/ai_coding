# Langfuse project the golden set is extracted from / published to
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# External production/staging agent this tool replays golden sets against.
# http_adapter.py POSTs {"input": <golden case input>, "correlation_id": <str>} here
# and expects {"output": <str or dict>, "tool_calls": [{"name": str, "input": dict}, ...]}
# back. tool_calls is optional if you rely on the Langfuse trace-lookup strategy instead
# (see src/agent_eval/simulate/tool_calls.py).
AGENT_ENDPOINT=https://staging.example.com/agent/invoke
AGENT_API_KEY=

# Model used for the LLM-as-judge evaluator (called via the `anthropic` SDK).
# Point ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN at the same gateway the rest of this
# repo uses if you are not calling api.anthropic.com directly.
JUDGE_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
